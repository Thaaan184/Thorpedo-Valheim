# Thorpedo Valheim Dedicated Server - Environment Template
# Copy this file to .env and configure secrets accordingly.

# --- Playit UDP Tunnel Secret ---
PLAYIT_SECRET_KEY=your_playit_secret_key_here

# --- Server Identity ---
SERVER_NAME=Thorpedo
WORLD_NAME=BarudakValheim
WORLD_SEED=z315pn
SERVER_PASSWORD=your_server_password_here

# --- Network Configuration ---
SERVER_PORT=2456
SERVER_QUERY_PORT=2457
SERVER_PUBLIC=0
CROSSPLAY=true

# --- World Rules & Modifiers ---
WORLD_MODIFIERS=resources=muchmore portals=casual
WORLD_KEYS=playerevents

# --- Persistence & Auto-Backups ---
SAVE_INTERVAL=1800
UPDATE_ON_START=true
VALIDATE_ON_UPDATE=false
BACKUPS=true
BACKUP_SHORT=7200
BACKUP_LONG=43200

# --- Server Mods & Localization ---
BEPINEX=true
TZ=Asia/Jakarta
ADMIN_IDS=

# --- GitHub Snapshot Releases Integration ---
GITHUB_TOKEN=your_github_fine_grained_pat_here
GITHUB_REPO=Thaaan184/Thorpedo-Valheim
PANEL_PORT=28456
